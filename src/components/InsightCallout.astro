---
interface Props {
  title: string;
  description: string;
  number?: number;
}

const { title, description, number } = Astro.props;
const formattedNumber = number ? String(number).padStart(2, '0') : null;
---

<div class="insight-callout">
  {formattedNumber && <span class="insight-number">{formattedNumber}</span>}
  <h4 class="insight-title">{title}</h4>
  <p class="insight-description">{description}</p>
</div>

<style>
  .insight-callout {
    position: relative;
    padding: var(--space-xl);
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-project-accent, var(--color-accent));
    overflow: hidden;
  }

  .insight-number {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-md);
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-project-accent, var(--color-accent));
    opacity: 0.12;
    pointer-events: none;
  }

  .insight-title {
    font-size: var(--text-h4);
    font-weight: 400;
    margin-bottom: var(--space-sm);
  }

  .insight-description {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: 0;
  }
</style>
