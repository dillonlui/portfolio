---
interface Props {
  title: string;
  description: string;
  tags: string[];
  heroImage: string;
  logoImage?: string;
  slug?: string;
  accentColor?: string;
}

const { title, description, tags, heroImage, logoImage, slug, accentColor = '#1a1a1a' } = Astro.props;
---

<section class="case-hero">
  <div class="container">
    <div class="hero-content">
      <div class="accent-strip"></div>
      {logoImage && (
        <img src={logoImage} alt={`${title} logo`} class="hero-logo" />
      )}
      <div class="hero-tags">
        {tags.map((tag) => (
          <span class="hero-tag">{tag}</span>
        ))}
      </div>
      <h1 class="hero-title">{title}</h1>
      <p class="hero-description">{description}</p>
    </div>
    <div class="hero-image-wrapper">
      <img src={heroImage} alt={title} class="hero-image" loading="eager" transition:name={slug ? `project-${slug}` : undefined} />
    </div>
  </div>
</section>

<style define:vars={{ accentColor }}>
  .case-hero {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-2xl);
  }

  .hero-content {
    max-width: 700px;
    margin-bottom: var(--space-2xl);
  }

  .accent-strip {
    width: 48px;
    height: 4px;
    background-color: var(--accentColor);
    border-radius: 2px;
    margin-bottom: var(--space-lg);
  }

  .hero-logo {
    height: 70px;
    width: auto;
    margin-bottom: var(--space-lg);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .hero-tag {
    font-size: var(--text-tag);
    font-weight: 500;
    color: var(--color-text-secondary);
    padding: var(--space-xs) var(--space-sm);
    background-color: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 400;
    line-height: var(--leading-tight);
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
    overflow-wrap: normal;
    word-break: normal;
  }

  .hero-description {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .hero-image-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.08),
      0 20px 60px color-mix(in srgb, var(--accentColor) 15%, transparent);
    will-change: transform;
  }

  .hero-image {
    width: 100%;
    height: auto;
  }

  @media (min-width: 768px) {
    .case-hero {
      padding-top: var(--space-4xl);
      padding-bottom: var(--space-3xl);
    }
  }
</style>
