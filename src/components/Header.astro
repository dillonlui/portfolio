---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/about', label: 'About' },
];

const caseStudies = [
  { href: '/projects/unified-platform', label: 'Unifying an Investigative Platform' },
  { href: '/projects/clearcase', label: 'ClearCase' },
  { href: '/projects/griefshare', label: 'GriefShare' },
  { href: '/projects/leadsuite', label: 'LeadSuite' },
  { href: '/projects/deposify', label: 'Deposify' },
];

function isActive(href: string): boolean {
  const normalizedPath = currentPath.endsWith('/') ? currentPath : currentPath + '/';
  const normalizedHref = href.endsWith('/') ? href : href + '/';

  if (href === '/') {
    return normalizedPath === '/';
  }
  return normalizedPath.startsWith(normalizedHref);
}

const isWorkActive = currentPath.startsWith('/projects');
---

<header class="header">
  <nav class="nav container">
    <a href="/" class="logo">
      <img src="/favicon.ico" alt="DL" class="logo-img" />
    </a>

    <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger"></span>
    </button>

    <ul class="nav-links">
      <!-- Work dropdown -->
      <li class="nav-item nav-item--dropdown">
        <button class:list={['nav-link', 'dropdown-trigger', { active: isWorkActive }]} aria-expanded="false" aria-haspopup="true">
          Work
          <svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <ul class="dropdown-menu" role="menu">
          {caseStudies.map((study) => (
            <li role="none">
              <a
                href={study.href}
                class:list={['dropdown-link', { active: isActive(study.href) }]}
                role="menuitem"
              >
                {study.label}
              </a>
            </li>
          ))}
        </ul>
      </li>

      {navLinks.map((link) => (
        <li class="nav-item">
          <a
            href={link.href}
            class:list={['nav-link', { active: isActive(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="nav-item">
        <a href="https://github.com/dillonlui/portfolio" target="_blank" rel="noopener noreferrer" class="nav-link nav-icon" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        </a>
      </li>
      <li class="nav-item">
        <a href="https://www.linkedin.com/in/dillonlui/" target="_blank" rel="noopener noreferrer" class="nav-link nav-icon" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </li>
      <li class="nav-item">
        <a href="mailto:dillonlui@gmail.com" class="nav-link nav-email">Email Me</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    height: var(--header-height);
    transition: background-color var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .header.is-scrolled {
    background-color: var(--color-background);
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-img {
    height: 30px;
    width: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 500;
    padding: var(--space-sm) 0;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-text);
  }

  /* Dropdown trigger */
  .dropdown-trigger {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: inherit;
    font-family: inherit;
  }

  .dropdown-chevron {
    transition: transform var(--transition-fast);
    flex-shrink: 0;
  }

  .nav-item--dropdown:hover .dropdown-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown menu */
  .dropdown-menu {
    position: absolute;
    top: calc(100% + var(--space-sm));
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    list-style: none;
    min-width: 220px;
    padding: var(--space-sm) 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-fast), visibility var(--transition-fast), transform var(--transition-fast);
    transform: translateX(-50%) translateY(-4px);
  }

  .nav-item--dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: var(--space-sm) var(--space-lg);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--text-sm);
    transition: color var(--transition-fast), background-color var(--transition-fast);
    white-space: nowrap;
  }

  .dropdown-link:hover,
  .dropdown-link.active {
    color: var(--color-text);
    background-color: var(--color-surface);
  }

  .nav-icon {
    display: flex;
    align-items: center;
  }

  .nav-icon svg {
    display: block;
  }

  .nav-email {
    font-weight: 500;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-sm);
  }

  .hamburger {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    position: relative;
    transition: background-color var(--transition-fast);
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    width: 24px;
    height: 2px;
    background-color: var(--color-text);
    left: 0;
    transition: transform var(--transition-fast);
  }

  .hamburger::before {
    top: -8px;
  }

  .hamburger::after {
    top: 8px;
  }

  /* Mobile styles */
  @media (max-width: 767px) {
    .mobile-menu-btn {
      display: block;
      z-index: var(--z-mobile-menu);
    }

    .nav-links {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-width: 300px;
      flex-direction: column;
      align-items: flex-start;
      background-color: var(--color-background);
      padding: calc(var(--header-height) + var(--space-xl)) var(--space-xl);
      gap: var(--space-lg);
      transform: translateX(100%);
      transition: transform var(--transition-base);
      box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
      overflow-y: auto;
    }

    .nav-links.is-open {
      transform: translateX(0);
    }

    .nav-link {
      font-size: var(--text-h3);
    }

    /* Mobile dropdown */
    .nav-item--dropdown {
      width: 100%;
    }

    .dropdown-trigger {
      font-size: var(--text-h3);
      width: 100%;
      justify-content: space-between;
      padding: var(--space-sm) 0;
    }

    .dropdown-menu {
      position: static;
      transform: none;
      box-shadow: none;
      border: none;
      border-left: 2px solid var(--color-border);
      border-radius: 0;
      padding: var(--space-sm) 0 var(--space-sm) var(--space-lg);
      margin-top: var(--space-sm);
      opacity: 1;
      visibility: visible;
      display: none;
    }

    .dropdown-menu.is-open {
      display: block;
    }

    .dropdown-link {
      font-size: var(--text-body);
      padding: var(--space-xs) 0;
      white-space: normal;
    }

    /* Hamburger animation when open */
    .mobile-menu-btn[aria-expanded="true"] .hamburger {
      background-color: transparent;
    }

    .mobile-menu-btn[aria-expanded="true"] .hamburger::before {
      transform: rotate(45deg) translate(5px, 6px);
    }

    .mobile-menu-btn[aria-expanded="true"] .hamburger::after {
      transform: rotate(-45deg) translate(5px, -6px);
    }
  }
</style>

<script>
  const menuBtn = document.querySelector('.mobile-menu-btn');
  const navLinks = document.querySelector('.nav-links');
  const dropdownTrigger = document.querySelector('.dropdown-trigger');
  const dropdownMenu = document.querySelector('.dropdown-menu');

  function closeMenu() {
    menuBtn?.setAttribute('aria-expanded', 'false');
    navLinks?.classList.remove('is-open');
  }

  menuBtn?.addEventListener('click', () => {
    const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', (!isOpen).toString());
    navLinks?.classList.toggle('is-open');
  });

  // Mobile: toggle dropdown on tap
  dropdownTrigger?.addEventListener('click', () => {
    const isMobile = window.innerWidth < 768;
    if (isMobile) {
      const isExpanded = dropdownTrigger.getAttribute('aria-expanded') === 'true';
      dropdownTrigger.setAttribute('aria-expanded', (!isExpanded).toString());
      dropdownMenu?.classList.toggle('is-open');
    }
  });

  // Close menu when a nav link is clicked
  navLinks?.querySelectorAll('.nav-link:not(.dropdown-trigger), .dropdown-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.nav') && navLinks?.classList.contains('is-open')) {
      closeMenu();
    }
  });

  // Scroll-aware header background
  const header = document.querySelector('.header');
  if (header) {
    const sentinel = document.createElement('div');
    sentinel.style.position = 'absolute';
    sentinel.style.top = '0';
    sentinel.style.height = '50px';
    sentinel.style.width = '1px';
    sentinel.style.pointerEvents = 'none';
    document.body.prepend(sentinel);

    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('is-scrolled', !entry.isIntersecting);
      },
      { threshold: 0 }
    );
    observer.observe(sentinel);
  }
</script>
