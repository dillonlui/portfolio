---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-content">
    <p class="copyright">&copy; {currentYear} Dillon Lui</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-xl) 0;
    margin-top: auto;
  }

  .footer-content {
    text-align: center;
  }

  .copyright {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    margin: 0;
  }
</style>
