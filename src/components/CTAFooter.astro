---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const currentYear = new Date().getFullYear();
---

<section class:list={['cta-footer', className]}>
  <div class="cta-dark">
    <div class="container cta-content">
      <h2 class="cta-heading">Let's work together,<br />drop me a line.</h2>
      <a href="mailto:dillonlui@gmail.com" class="cta-btn">Email Me</a>
    </div>
    <div class="container cta-copyright">
      <p>&copy; {currentYear} Dillon Lui</p>
    </div>
  </div>
</section>

<style>
  .cta-footer {
    margin-top: auto;
  }

  .cta-dark {
    background-color: var(--color-dark-accent);
    padding: var(--space-3xl) 0 var(--space-lg);
    padding-top: calc(var(--space-3xl) + 4vw);
    text-align: center;
    clip-path: polygon(0 4vw, 100% 0, 100% 100%, 0 100%);
  }

  .cta-content {
    max-width: 800px;
    margin-bottom: var(--space-xl);
  }

  @media (max-width: 767px) {
    .cta-dark {
      padding: var(--space-2xl) 0 var(--space-md);
      padding-top: calc(var(--space-2xl) + 4vw);
    }

    .cta-content {
      margin-bottom: var(--space-lg);
    }

    .cta-heading {
      font-size: var(--text-h2);
    }
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    margin-bottom: var(--space-lg);
    color: var(--color-background);
  }

  .cta-btn {
    display: inline-block;
    padding: var(--space-sm) var(--space-xl);
    font-size: var(--text-body);
    font-weight: 500;
    color: white;
    background-color: var(--color-accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .cta-btn:hover {
    background-color: var(--color-accent-hover);
    color: white;
  }

  .cta-copyright p {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    margin: 0;
  }
</style>

