---
interface Props {
  class?: string;
  surfaceBg?: boolean;
}
const { class: className, surfaceBg = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<section class:list={['cta-footer', className]}>
  <div class:list={['wave-divider', { 'wave-surface': surfaceBg }]}>
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,60 C240,120 480,0 720,60 C960,120 1200,0 1440,60 L1440,120 L0,120 Z" fill="var(--color-dark-accent)" />
    </svg>
  </div>
  <div class="cta-dark">
    <div class="container cta-content">
      <h2 class="cta-heading">Let's work together, drop me a line.</h2>
      <a href="mailto:dillonlui@gmail.com" class="cta-btn">Email Me</a>
    </div>
    <div class="container cta-copyright">
      <p>&copy; {currentYear} Dillon Lui</p>
    </div>
  </div>
</section>

<style>
  .cta-footer {
    margin-top: auto;
  }

  .wave-divider {
    line-height: 0;
    margin-bottom: -1px;
  }

  .wave-surface {
    background-color: var(--color-surface);
  }

  .wave-divider svg {
    width: 100%;
    height: 80px;
    display: block;
  }

  .cta-dark {
    background-color: var(--color-dark-accent);
    padding: var(--space-3xl) 0 var(--space-lg);
    text-align: center;
  }

  .cta-content {
    max-width: 800px;
    margin-bottom: var(--space-3xl);
  }

  .cta-heading {
    font-size: var(--text-h2);
    font-weight: 600;
    margin-bottom: var(--space-lg);
    color: var(--color-background);
  }

  .cta-btn {
    display: inline-block;
    padding: var(--space-sm) var(--space-xl);
    font-size: var(--text-body);
    font-weight: 500;
    color: white;
    background-color: var(--color-accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .cta-btn:hover {
    background-color: var(--color-accent-hover);
    color: white;
  }

  .cta-copyright p {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    margin: 0;
  }
</style>
