---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="full-width-image">
  <div class="image-wrapper">
    <img src={src} alt={alt} loading="lazy" />
  </div>
  {caption && <figcaption class="image-caption">&mdash; {caption}</figcaption>}
</figure>

<style>
  .full-width-image {
    margin: 0;
  }

  .full-width-image + .full-width-image {
    margin-top: var(--space-2xl);
  }

  .image-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.06),
      0 12px 40px color-mix(in srgb, var(--color-project-accent, #1a1a1a) 10%, transparent);
  }

  .image-wrapper img {
    width: 100%;
    height: auto;
  }

  .image-caption {
    margin-top: var(--space-sm);
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-align: left;
  }
</style>
