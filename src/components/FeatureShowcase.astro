---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  title: string;
  description?: string;
  reverse?: boolean;
}

const { image, title, description, reverse = false } = Astro.props;
---

<div class:list={['feature-showcase', { reverse }]}>
  <div class="showcase-image-wrapper">
    <Picture
      src={image}
      alt={title}
      widths={[400, 600, 900, 1200]}
      formats={['avif', 'webp']}
      sizes="(max-width: 768px) 100vw, 60vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="showcase-content">
    <h3 class="showcase-title">{title}</h3>
    {description && <p class="showcase-description">{description}</p>}
  </div>
</div>

<style>
  .feature-showcase {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .feature-showcase {
      grid-template-columns: 1.2fr 1fr;
    }

    .feature-showcase.reverse {
      grid-template-columns: 1fr 1.2fr;
    }

    .feature-showcase.reverse .showcase-image-wrapper {
      order: 2;
    }

    .feature-showcase.reverse .showcase-content {
      order: 1;
    }
  }

  .showcase-image-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .showcase-image-wrapper img {
    width: 100%;
    height: auto;
  }

  .showcase-title {
    font-size: var(--text-h3);
    margin-bottom: var(--space-sm);
  }

  .showcase-description {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }
</style>
