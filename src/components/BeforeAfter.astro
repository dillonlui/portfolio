---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  beforeImage: ImageMetadata;
  afterImage: ImageMetadata;
  beforeLabel?: string;
  afterLabel?: string;
  beforeAlt?: string;
  afterAlt?: string;
}

const { beforeImage, afterImage, beforeLabel = 'Before', afterLabel = 'After', beforeAlt, afterAlt } = Astro.props;
---

<div class="before-after">
  <div class="ba-item">
    <span class="ba-label">{beforeLabel}</span>
    <div class="ba-image-wrapper">
      <Picture
        src={beforeImage}
        alt={beforeAlt || `${beforeLabel} view`}
        widths={[400, 600, 900]}
        formats={['avif', 'webp']}
        sizes="(max-width: 768px) 100vw, 50vw"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
  <div class="ba-item">
    <span class="ba-label">{afterLabel}</span>
    <div class="ba-image-wrapper">
      <Picture
        src={afterImage}
        alt={afterAlt || `${afterLabel} view`}
        widths={[400, 600, 900]}
        formats={['avif', 'webp']}
        sizes="(max-width: 768px) 100vw, 50vw"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</div>

<style>
  .before-after {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .before-after {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ba-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .ba-label {
    font-size: var(--text-caption);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
  }

  .ba-image-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .ba-image-wrapper img {
    width: 100%;
    height: auto;
  }
</style>
