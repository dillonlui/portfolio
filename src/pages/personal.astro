---
import { Picture, Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAFooter from '../components/CTAFooter.astro';

import featuredThumbnail from '../assets/images/projects/unified-platform/thumbnail.png';
import ficccHomepage from '../assets/images/projects/personal/ficcc-homepage.png';
import ficccAbout from '../assets/images/projects/personal/ficcc-about.png';
import ficccVisit from '../assets/images/projects/personal/ficcc-visit.png';
import barbellDashboard from '../assets/images/projects/personal/barbell-dashboard.png';
import barbellSession from '../assets/images/projects/personal/barbell-session.png';
import barbellTrends from '../assets/images/projects/personal/barbell-trends.png';
import barbellCalendar from '../assets/images/projects/personal/barbell-calendar.png';
import newsBriefingHomepage from '../assets/images/projects/personal/news-briefing-homepage.png';
import newsBriefingStory from '../assets/images/projects/personal/news-briefing-story.png';

const ficccImages = [
  { src: ficccHomepage, alt: 'FICCC homepage with bilingual navigation, hero image, and service times' },
  { src: ficccAbout, alt: 'FICCC about page showing church history timeline and community stats' },
  { src: ficccVisit, alt: 'FICCC visit page with Sunday schedule and directions' },
];

const barbellImages = [
  { src: barbellDashboard, alt: 'Barbell app dashboard showing today\'s training plan with lifts and weights' },
  { src: barbellSession, alt: 'Active workout session showing squat warm-up sets and working sets' },
  { src: barbellTrends, alt: 'Trends view with bench press progression chart over time' },
  { src: barbellCalendar, alt: 'History calendar showing workout days marked in April 2026' },
];

const newsImages = [
  { src: newsBriefingHomepage, alt: 'News Briefing daily edition with clustered story cards and topic filters' },
  { src: newsBriefingStory, alt: 'Story detail page showing AI-generated summary, key facts, and source attribution' },
];
---

<BaseLayout title="Personal Projects - Dillon Lui" description="Side projects I've built for fun and impact outside of my day job, from non-profit web sponsorship to AI-powered news briefings.">
  <section class="page-header section">
    <div class="container">
      <h1 class="page-title fade-in">Personal Projects</h1>
      <p class="page-intro fade-in">
        I care about building things that matter - whether it's helping a non-profit reach their community, solving friction I feel every day, or exploring how AI can make information more useful. These are projects I've built outside of work.
      </p>
    </div>
  </section>

  <!-- FICCC -->
  <section class="project-section section fade-in">
    <div class="container">
      <h2 class="project-title">Non-profit Web Sponsorship</h2>
      <p class="project-summary">Rebuilding outdated church and non-profit websites on modern, maintainable stacks.</p>

      <div class="gallery">
        {ficccImages.map((img) => (
          <Picture
            src={img.src}
            alt={img.alt}
            class="gallery-image"
            formats={['avif', 'webp']}
            widths={[400, 600, 800]}
            sizes="(max-width: 767px) 85vw, 33vw"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>

      <div class="glance-card">
        <div class="glance-meta">
          <div class="glance-item">
            <span class="glance-label">Stack</span>
            <span class="glance-value">Astro, Sanity CMS, Vercel, Playwright, axe-core</span>
          </div>
          <div class="glance-item">
            <span class="glance-label">Features</span>
            <span class="glance-value">Bilingual (EN/中文), CMS-driven content, form handling, accessibility audited</span>
          </div>
          <div class="glance-item">
            <span class="glance-label">Partner</span>
            <span class="glance-value">First Ithaca Chinese Christian Church</span>
          </div>
        </div>
        <div class="glance-description">
          <p>A lot of churches and non-profits are stuck on aging platforms that nobody on staff knows how to update. I volunteer to rebuild them on a modern stack that non-technical teams can actually maintain. FICCC needed a bilingual site (English and Chinese) with CMS-driven content, form handling, and accessibility built in. The site is live and actively used by the church community.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Barbell -->
  <section class="project-section section fade-in">
    <div class="container">
      <h2 class="project-title">Barbell - Weightlifting Tracker</h2>
      <p class="project-summary">A focused app for tracking a minimalist barbell program and seeing progress over time.</p>

      <div class="gallery gallery--phones">
        {barbellImages.map((img) => (
          <Picture
            src={img.src}
            alt={img.alt}
            class="gallery-image gallery-image--phone"
            formats={['avif', 'webp']}
            widths={[193, 386]}
            sizes="(max-width: 767px) 45vw, 200px"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>

      <div class="glance-card">
        <div class="glance-meta">
          <div class="glance-item">
            <span class="glance-label">Stack</span>
            <span class="glance-value">Next.js, React, Supabase, Tailwind, Framer Motion, Recharts</span>
          </div>
          <div class="glance-item">
            <span class="glance-label">Features</span>
            <span class="glance-value">Auto-progression, rest timer, trend charts, personal records, calendar history</span>
          </div>
          <div class="glance-item">
            <span class="glance-label">Built with</span>
            <span class="glance-value">Claude Code</span>
          </div>
        </div>
        <div class="glance-description">
          <p>Generic fitness apps add a lot of friction for what should be a simple workflow. Barbell strips it down to the essentials: log your sets, follow a structured progression, and see your trends over time. I designed the interaction model around speed and clarity, so logging a workout takes seconds instead of minutes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- News Briefing -->
  <section class="project-section section fade-in">
    <div class="container">
      <h2 class="project-title">News Briefing - Daily Summary</h2>
      <p class="project-summary">A lightweight AI-powered app that clusters headlines into a focused daily briefing.</p>

      <div class="gallery">
        {newsImages.map((img) => (
          <Picture
            src={img.src}
            alt={img.alt}
            class="gallery-image"
            formats={['avif', 'webp']}
            widths={[400, 600, 800]}
            sizes="(max-width: 767px) 85vw, 50vw"
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>

      <div class="glance-card">
        <div class="glance-meta">
          <div class="glance-item">
            <span class="glance-label">Stack</span>
            <span class="glance-value">Next.js, Claude API, Neon Postgres, Drizzle ORM, Resend, Upstash QStash</span>
          </div>
          <div class="glance-item">
            <span class="glance-label">Features</span>
            <span class="glance-value">RSS ingestion (16 sources), AI clustering, daily editions, email delivery, dark mode</span>
          </div>
          <div class="glance-item">
            <span class="glance-label">Built with</span>
            <span class="glance-value">Claude Code</span>
          </div>
        </div>
        <div class="glance-description">
          <p>News feeds are noisy and repetitive. I wanted something that would cut through the clutter and give me one clean page to read each morning. News Briefing ingests RSS feeds from 16 sources, uses AI to cluster related articles into unified stories, and serves up a daily edition focused on readability and information hierarchy.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="featured-project section fade-in">
    <div class="container featured-grid">
      <div class="featured-content">
        <h2 class="featured-heading">Want to see my professional work?</h2>
        <p class="featured-label">Check out my featured case study on redesigning an investigative platform used by law enforcement analysts</p>
        <a href="/projects/unified-platform" class="btn btn-secondary">View Case Study</a>
      </div>
      <a href="/projects/unified-platform" class="featured-link">
        <Image
          src={featuredThumbnail}
          alt="Unifying an Investigative Platform case study"
          class="featured-image"
          widths={[360, 600]}
          sizes="(max-width: 768px) 90vw, 360px"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <CTAFooter />
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-xl);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    margin-bottom: var(--space-md);
  }

  .page-intro {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 680px;
  }

  /* Project sections */
  .project-section {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .project-section + .project-section > .container::before {
    content: '';
    display: block;
    height: 1px;
    background-color: var(--color-border);
    margin-bottom: var(--space-xl);
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: 400;
    margin-bottom: var(--space-xs);
  }

  .project-summary {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-xl);
  }

  /* Image gallery - desktop: side by side */
  .gallery {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .gallery-image {
    flex: 1;
    min-width: 0;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  /* Phone screenshots: fixed width on desktop, flex in carousel on mobile */
  @media (min-width: 768px) {
    .gallery--phones {
      justify-content: center;
    }

    .gallery-image--phone {
      flex: 0 0 auto;
      width: 200px;
    }
  }

  /* At a Glance card */
  .glance-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    background-color: var(--color-surface);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-accent);
    padding: var(--space-xl);
  }

  .glance-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .glance-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .glance-label {
    font-family: var(--font-heading);
    font-size: var(--text-caption);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
  }

  .glance-value {
    font-size: var(--text-body);
    color: var(--color-text);
    line-height: var(--leading-normal);
  }

  .glance-description p {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (min-width: 768px) {
    .glance-card {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-2xl);
    }
  }

  /* Mobile: carousel with scroll-snap */
  @media (max-width: 767px) {
    .gallery {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: var(--space-sm);
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .gallery::-webkit-scrollbar {
      display: none;
    }

    .gallery .gallery-image {
      flex: 0 0 85%;
      scroll-snap-align: center;
    }

    .gallery .gallery-image--phone {
      flex: 0 0 45%;
    }
  }

  /* Featured project CTA */
  .featured-project {
    background-color: var(--color-surface);
    padding-bottom: calc(var(--space-3xl) + 5vw);
    position: relative;
    z-index: 0;
  }

  .featured-project + :global(.cta-footer) {
    position: relative;
    z-index: 1;
    margin-top: -5vw;
  }

  .featured-grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .featured-content {
    text-align: center;
  }

  .featured-heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    margin-bottom: var(--space-sm);
  }

  .featured-label {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  .featured-link {
    display: block;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    max-width: 360px;
    margin: 0 auto;
  }

  .featured-link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .featured-image {
    width: 100%;
    height: auto;
  }

  @media (min-width: 768px) {
    .featured-grid {
      grid-template-columns: 1fr 380px;
    }

    .featured-content {
      text-align: left;
    }

    .featured-link {
      margin: 0;
    }
  }
</style>

<script>
  import { initFadeIn } from '../scripts/scroll-animations';

  document.addEventListener('astro:page-load', () => {
    const path = window.location.pathname.replace(/\/$/, '');
    if (path !== '/personal') return;
    initFadeIn();
  });
</script>
