---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAFooter from '../components/CTAFooter.astro';

import ficccHomepage from '../assets/images/projects/personal/ficcc-homepage.png';
import barbellDashboard from '../assets/images/projects/personal/barbell-dashboard.png';
import barbellTrends from '../assets/images/projects/personal/barbell-trends.png';
import newsBriefingHomepage from '../assets/images/projects/personal/news-briefing-homepage.png';
---

<BaseLayout title="Personal Projects - Dillon Lui" description="Side projects I've built for fun and impact outside of my day job, from non-profit web sponsorship to AI-powered news briefings.">
  <section class="page-header section">
    <div class="container">
      <h1 class="page-title fade-in">Personal Projects</h1>
      <p class="page-intro fade-in">
        I care about building things that matter - whether it's helping a non-profit reach their community, solving friction I feel every day, or exploring how AI can make information more useful. These are projects I've built outside of work.
      </p>
    </div>
  </section>

  <section class="project-section section fade-in">
    <div class="container project-grid">
      <div class="project-text">
        <h2 class="project-title">Non-profit Web Sponsorship</h2>
        <p class="project-summary">Rebuilding outdated church and non-profit websites on modern, maintainable stacks.</p>
        <p class="project-tech">Astro, Sanity CMS, Vercel - Design, development, content modeling</p>
        <p class="project-body">
          A lot of churches and non-profits are stuck on aging platforms that nobody on staff knows how to update. I volunteer to rebuild them on a modern stack that non-technical teams can actually maintain. First Ithaca Chinese Christian Church needed a bilingual site (English and Chinese) with CMS-driven content, form handling, and accessibility built in. The site is live and actively used by the church community.
        </p>
        <p class="project-partner">Partner: First Ithaca Chinese Christian Church</p>
      </div>
      <div class="project-image">
        <Image
          src={ficccHomepage}
          alt="FICCC website homepage showing bilingual navigation, hero section, and service times"
          class="screenshot"
          widths={[400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 45vw"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="project-section project-section--reversed section fade-in">
    <div class="container project-grid">
      <div class="project-text">
        <h2 class="project-title">Barbell - Weightlifting Tracker</h2>
        <p class="project-summary">A focused app for tracking a minimalist barbell program and seeing progress over time.</p>
        <p class="project-tech">Next.js, Supabase, Tailwind - Product design, UX, front-end</p>
        <p class="project-body">
          Generic fitness apps add a lot of friction for what should be a simple workflow. Barbell strips it down to the essentials: log your sets, follow a structured progression, and see your trends over time. I designed the interaction model around speed and clarity, so logging a workout takes seconds instead of minutes. Built with Claude Code.
        </p>
      </div>
      <div class="project-image">
        <div class="phone-pair">
          <Image
            src={barbellDashboard}
            alt="Barbell app home dashboard showing today's training plan with squat, bench, row, and OHP lifts"
            class="screenshot phone-screenshot"
            widths={[193, 386]}
            sizes="(max-width: 768px) 45vw, 180px"
            loading="lazy"
            decoding="async"
          />
          <Image
            src={barbellTrends}
            alt="Barbell app trends view showing bench press progression chart and personal records"
            class="screenshot phone-screenshot"
            widths={[193, 386]}
            sizes="(max-width: 768px) 45vw, 180px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="project-section section fade-in">
    <div class="container project-grid">
      <div class="project-text">
        <h2 class="project-title">News Briefing - Daily Summary</h2>
        <p class="project-summary">A lightweight app that clusters headlines into a focused daily briefing.</p>
        <p class="project-tech">Next.js, Claude API, Neon Postgres - Product design, UX, front-end</p>
        <p class="project-body">
          News feeds are noisy and repetitive. I wanted something that would cut through the clutter and give me one clean page to read each morning. News Briefing ingests RSS feeds from 16 sources, uses AI to cluster related articles into unified stories, and serves up a daily edition focused on readability and information hierarchy. Built with Claude Code.
        </p>
      </div>
      <div class="project-image">
        <Image
          src={newsBriefingHomepage}
          alt="News Briefing app showing daily edition with clustered story cards and topic navigation"
          class="screenshot"
          widths={[400, 600, 800]}
          sizes="(max-width: 768px) 100vw, 45vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <CTAFooter />
</BaseLayout>

<style>
  .page-header {
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-xl);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    margin-bottom: var(--space-md);
  }

  .page-intro {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 680px;
  }

  /* Project sections */
  .project-section {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .project-grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: 400;
    margin-bottom: var(--space-xs);
  }

  .project-summary {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-sm);
  }

  .project-tech {
    font-size: var(--text-caption);
    color: var(--color-text-muted, var(--color-text-secondary));
    margin-bottom: var(--space-lg);
  }

  .project-body {
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .project-partner {
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
    font-style: italic;
    margin-top: var(--space-md);
  }

  .screenshot {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  /* Phone pair for Barbell screenshots */
  .phone-pair {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
  }

  .phone-screenshot {
    width: calc(50% - var(--space-sm));
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  /* Desktop: two-column grid with alternating layout */
  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: 1.2fr 1fr;
    }

    /* Reversed: image left, text right */
    .project-section--reversed .project-grid {
      grid-template-columns: 1fr 1.2fr;
    }

    .project-section--reversed .project-text {
      order: 2;
    }

    .project-section--reversed .project-image {
      order: 1;
    }
  }

  /* Mobile: image above text */
  @media (max-width: 767px) {
    .project-image {
      order: -1;
    }

    .phone-pair {
      max-width: 320px;
      margin: 0 auto;
    }
  }
</style>

<script>
  import { initFadeIn } from '../scripts/scroll-animations';

  document.addEventListener('astro:page-load', () => {
    if (!window.location.pathname.startsWith('/personal')) return;
    initFadeIn();
  });
</script>
