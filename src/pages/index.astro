---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Sample project data - replace with content collection later
// Use placeholder.svg until real images are added
const projects = [
  {
    title: 'Mobile Banking Redesign',
    description: 'A comprehensive redesign of a mobile banking application focusing on accessibility and user experience.',
    thumbnail: '/images/placeholder.svg',
    slug: 'project-1',
    tags: ['UX Design', 'Mobile', 'Fintech'],
  },
  {
    title: 'SaaS Design System',
    description: 'Building a design system from the ground up for a growing SaaS platform.',
    thumbnail: '/images/placeholder.svg',
    slug: 'project-2',
    tags: ['Design Systems', 'Web', 'B2B'],
  },
  {
    title: 'E-commerce Optimization',
    description: 'E-commerce experience redesign that increased conversion rates by 40%.',
    thumbnail: '/images/placeholder.svg',
    slug: 'project-3',
    tags: ['E-commerce', 'UX Research', 'Web'],
  },
];
---

<BaseLayout title="Portfolio | Home">
  <section class="hero section">
    <div class="container">
      <h1 class="hero-title fade-in">Design & Development</h1>
      <p class="hero-subtitle fade-in">
        Creating thoughtful digital experiences through design and code.
      </p>
    </div>
  </section>

  <section class="projects section">
    <div class="container">
      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-2xl);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .projects {
    padding-top: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3xl);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Set initial states
  gsap.set('.hero-title', { opacity: 0, y: 30 });
  gsap.set('.hero-subtitle', { opacity: 0, y: 30 });
  gsap.set('.project-card', { opacity: 0, y: 40 });

  // Animate hero elements
  gsap.to('.hero-title', {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: 'power3.out',
  });

  gsap.to('.hero-subtitle', {
    opacity: 1,
    y: 0,
    duration: 0.8,
    delay: 0.2,
    ease: 'power3.out',
  });

  // Animate project cards on scroll
  gsap.utils.toArray('.project-card').forEach((card, i) => {
    gsap.to(card as Element, {
      scrollTrigger: {
        trigger: card as Element,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      opacity: 1,
      y: 0,
      duration: 0.6,
      delay: i * 0.1,
      ease: 'power3.out',
    });
  });
</script>
