---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingCanvas from '../components/FloatingCanvas.astro';
import CTAFooter from '../components/CTAFooter.astro';
import ogThumbnail from '../assets/images/projects/unified-platform/thumbnail.png';
---

<BaseLayout title="Dillon Lui - Product Designer" description="Product designer specializing in complex B2B SaaS. Case studies from LeadsOnline, Church Initiative, and CrateBind." image={ogThumbnail.src}>
  <section class="hero section">
    <div class="container">
      <h1 class="hero-title hero-title-home fade-in">Hello, I'm Dillon 👋</h1>
      <p class="hero-subtitle fade-in">
        Senior product designer leading design across a B2B SaaS product suite. I shape how teams build, from strategy through working code.
      </p>
      <p class="hero-blurb fade-in">
        Currently at LeadsOnline, where I lead design for investigative tools used by law enforcement agencies worldwide.
      </p>
      <div class="hero-cta fade-in">
        <p>Interested in working together?</p>
        <a href="mailto:dillonlui@gmail.com" class="btn btn-secondary">Email me</a>
      </div>
    </div>
  </section>

  <FloatingCanvas />

  <CTAFooter />
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-4xl);
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: var(--space-4xl);
    }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 400;
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-sm);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title {
      opacity: 1;
    }
  }

  .hero-subtitle {
    font-size: var(--text-h3);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    margin-bottom: var(--space-md);
  }

  @media (min-width: 768px) {
    .hero-subtitle {
      margin-top: -20px;
    }
  }

  .hero-blurb {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-md);
  }

  .hero-cta {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    margin-top: var(--space-sm);
  }

  .hero-cta .btn {
    margin-top: 4px;
    display: inline-block;
  }
</style>

<script>
  import { initHeroAnimation, initParallax } from '../scripts/scroll-animations';
  import { initHeroLetterReveal } from '../scripts/hover-effects';

  document.addEventListener('astro:page-load', () => {
    if (window.location.pathname !== '/') return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      document.querySelectorAll<HTMLElement>('.hero-title, .hero-subtitle, .hero-blurb, .hero-cta').forEach((el) => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
      return;
    }

    initHeroLetterReveal();
    initHeroAnimation(['.hero-subtitle', '.hero-blurb', '.hero-cta']);
    initParallax('.hero-title', -50);
    initParallax('.hero-subtitle', -30);
  });
</script>
