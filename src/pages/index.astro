---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FeaturedProjectCard from '../components/FeaturedProjectCard.astro';
import CTAFooter from '../components/CTAFooter.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects'))
  .filter((p) => !p.data.archived)
  .sort((a, b) => a.data.order - b.data.order);

const featuredProject = allProjects.find((p) => p.data.featured);
const projects = allProjects.filter((p) => !p.data.featured);
---

<BaseLayout title="Dillon Lui  - Product Designer" description="Product designer specializing in complex B2B SaaS. Case studies from LeadsOnline, Church Initiative, and CrateBind." image="/images/projects/unified-platform/thumbnail.png">
  <section class="hero section">
    <div class="container">
      <h1 class="hero-title fade-in">Hello, I'm Dillon 👋🏼</h1>
      <p class="hero-subtitle fade-in">
        Senior product designer leading design across a B2B SaaS product suite. I shape how teams build, from strategy through working code.
      </p>
      <p class="hero-blurb fade-in">
        Currently at LeadsOnline, where I lead design for investigative tools used by law enforcement agencies nationwide.
      </p>
      <p class="hero-cta fade-in">
        Interested in working together? <a href="mailto:dillonlui@gmail.com">Email me</a>
      </p>
    </div>
  </section>

  <section class="projects section">
    <div class="container">
      {featuredProject && (
        <div class="featured-wrapper">
          <FeaturedProjectCard
            title={featuredProject.data.title}
            description={featuredProject.data.description}
            thumbnail={featuredProject.data.thumbnail}
            slug={featuredProject.data.slug}
            tags={featuredProject.data.tags}
            thumbnailPosition={featuredProject.data.thumbnailPosition}
          />
        </div>
      )}
      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            thumbnail={project.data.thumbnail}
            slug={project.data.slug}
            tags={project.data.tags}
            thumbnailPosition={project.data.thumbnailPosition}
          />
        ))}
      </div>

    </div>
  </section>

  <CTAFooter />
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-3xl);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 400;
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: var(--text-h3);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    margin-bottom: var(--space-md);
  }

  .hero-blurb {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-md);
  }

  .hero-cta {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
  }

  .hero-cta a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-cta a:hover {
    color: var(--color-text-secondary);
  }

  .projects {
    padding-top: 0;
  }

  .featured-wrapper {
    margin-bottom: var(--space-2xl);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3xl);
    }
  }
</style>

<script>
  import { initHeroAnimation, initStaggerAnimation } from '../scripts/scroll-animations';

  initHeroAnimation(['.hero-title', '.hero-subtitle', '.hero-blurb', '.hero-cta']);
  initStaggerAnimation('.project-card');
</script>
