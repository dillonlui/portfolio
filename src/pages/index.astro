---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingCanvas from '../components/FloatingCanvas.astro';
import CTAFooter from '../components/CTAFooter.astro';
---

<BaseLayout title="Dillon Lui  - Product Designer" description="Product designer specializing in complex B2B SaaS. Case studies from LeadsOnline, Church Initiative, and CrateBind." image="/images/projects/unified-platform/thumbnail.png">
  <section class="hero section">
    <div class="container">
      <h1 class="hero-title fade-in">Hello, I'm Dillon 👋🏼</h1>
      <p class="hero-subtitle fade-in">
        Senior product designer leading design across a B2B SaaS product suite. I shape how teams build, from strategy through working code.
      </p>
      <p class="hero-blurb fade-in">
        Currently at LeadsOnline, where I lead design for investigative tools used by law enforcement agencies nationwide.
      </p>
      <p class="hero-cta fade-in">
        Interested in working together? <a href="mailto:dillonlui@gmail.com">Email me</a>
      </p>
    </div>
  </section>

  <FloatingCanvas />

  <CTAFooter />
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-4xl);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 400;
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: var(--text-h3);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    margin-bottom: var(--space-lg);
  }

  .hero-blurb {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-lg);
  }

  .hero-cta {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
  }

  .hero-cta a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-cta a:hover {
    color: var(--color-text-secondary);
  }
</style>

<script>
  import { initHeroAnimation, initParallax } from '../scripts/scroll-animations';

  initHeroAnimation(['.hero-title', '.hero-subtitle', '.hero-blurb', '.hero-cta']);
  initParallax('.hero-title', -50);
  initParallax('.hero-subtitle', -30);
</script>
