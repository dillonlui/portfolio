---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTAFooter from '../components/CTAFooter.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Dillon Lui — Product Designer">
  <section class="hero section">
    <div class="container">
      <h1 class="hero-title fade-in">Hello, I'm Dillon 👋🏼</h1>
      <p class="hero-subtitle fade-in">
        I'm a Product Designer and Webflow Developer with a passion for creating simple solutions to complex problems.
      </p>
      <p class="hero-cta fade-in">
        Interested in working together? <a href="mailto:dillonlui@gmail.com">Email me</a>
      </p>
    </div>
  </section>

  <section class="projects section">
    <div class="container">
      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            thumbnail={project.data.thumbnail}
            slug={project.data.slug}
            tags={project.data.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <CTAFooter />
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-2xl);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin-bottom: var(--space-lg);
  }

  .hero-cta {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .hero-cta a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-cta a:hover {
    color: var(--color-text-secondary);
  }

  .projects {
    padding-top: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3xl);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.set('.hero-title', { opacity: 0, y: 30 });
  gsap.set('.hero-subtitle', { opacity: 0, y: 30 });
  gsap.set('.hero-cta', { opacity: 0, y: 30 });
  gsap.set('.project-card', { opacity: 0, y: 40 });

  gsap.to('.hero-title', {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: 'power3.out',
  });

  gsap.to('.hero-subtitle', {
    opacity: 1,
    y: 0,
    duration: 0.8,
    delay: 0.2,
    ease: 'power3.out',
  });

  gsap.to('.hero-cta', {
    opacity: 1,
    y: 0,
    duration: 0.8,
    delay: 0.3,
    ease: 'power3.out',
  });

  gsap.utils.toArray('.project-card').forEach((card, i) => {
    gsap.to(card as Element, {
      scrollTrigger: {
        trigger: card as Element,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      opacity: 1,
      y: 0,
      duration: 0.6,
      delay: i * 0.1,
      ease: 'power3.out',
    });
  });
</script>
