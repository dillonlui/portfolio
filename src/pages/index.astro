---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTAFooter from '../components/CTAFooter.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Dillon Lui — Product Designer">
  <section class="hero section">
    <div class="container">
      <h1 class="hero-title fade-in">Hello, I'm Dillon 👋🏼</h1>
      <p class="hero-subtitle fade-in">
        I'm a Product Designer and builder, creating simple solutions to complex problems.
      </p>
      <p class="hero-cta fade-in">
        Interested in working together? <a href="mailto:dillonlui@gmail.com">Email me</a>
      </p>
    </div>
  </section>

  <section class="projects section">
    <div class="container">
      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            thumbnail={project.data.thumbnail}
            slug={project.data.slug}
            tags={project.data.tags}
            thumbnailPosition={project.data.thumbnailPosition}
          />
        ))}
      </div>
    </div>
  </section>

  <CTAFooter />
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-2xl);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 400;
    margin-bottom: var(--space-md);
  }

  .hero-subtitle {
    font-size: var(--text-h3);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: none;
    margin-bottom: var(--space-lg);
  }

  .hero-cta {
    font-size: var(--text-body-lg);
    color: var(--color-text-secondary);
  }

  .hero-cta a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-cta a:hover {
    color: var(--color-text-secondary);
  }

  .projects {
    padding-top: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-3xl);
    }
  }
</style>

<script>
  import { initHeroAnimation, initStaggerAnimation } from '../scripts/scroll-animations';

  initHeroAnimation(['.hero-title', '.hero-subtitle', '.hero-cta']);
  initStaggerAnimation('.project-card');
</script>
