---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAFooter from '../components/CTAFooter.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="About — Dillon Lui">
  <section class="about-hero section">
    <div class="container">
      <div class="about-intro">
        <h1 class="intro-greeting fade-in">hey there 👋🏼</h1>
        <p class="intro-headline fade-in">I'm Dillon, I like to create experiences for real people.</p>
      </div>
      <div class="about-grid">
        <div class="about-image-wrapper fade-in">
          <img
            src={`${base}/images/profile/dillon.jpg`}
            alt="Dillon Lui"
            class="profile-image"
          />
        </div>
        <div class="about-content fade-in">
          <p>
            With a background in healthcare and religious non-profits, my passion has always been to serve and help people. I shifted careers into product design 3+ years ago to adopt technology as a new medium to better our world.
          </p>
          <p>
            I draw from nearly a decade of experience in leading teams to accomplish organizational goals. I believe that problem solving is an ongoing process that requires continuous feedback, tweaks, and reimplementation.
          </p>
          <p>
            I love going through the problem solving cycle and evaluating processes and decisions. Basically, <strong>figuring out complex problems is my jam.</strong>
          </p>
          <p>
            My designs create streamlined flows that always keep the end user in mind. This is because the success or failure of any process or design is measured by the <strong>value given to its users</strong>.
          </p>
          <p>
            My approach requires clearly defined goals that are specific yet flexible as feedback is received. <strong>I keep teams focused by designing structures that keep real people in mind</strong>.
          </p>
          <p>
            Outside of work I find inspiration through spending time in nature, roasting my own coffee, and meeting new people. I also watch a lot of cat videos 😸
          </p>
          <a href="https://drive.google.com/file/d/1ziiJcxYVU5AAVi1M4CZld9--_wqJZmOu/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="resume-btn">Download Resume</a>
        </div>
      </div>
    </div>
  </section>

  <section class="experience section">
    <div class="container">
      <h2 class="section-title fade-in">Experience</h2>
      <div class="experience-list">
        <div class="experience-item fade-in">
          <div class="experience-header">
            <h3>LeadsOnline</h3>
            <span class="experience-meta">Law Enforcement Tech &middot; Senior Product Designer</span>
            <span class="experience-date">December 2024 &ndash; Present</span>
          </div>
          <ul class="experience-details">
            <li>Primary product designer supporting multiple SaaS products from established products to MVP</li>
            <li>Established internal design system to unify across brands and products</li>
            <li>Expanded work to include photo, video, and live streaming as needed</li>
          </ul>
        </div>

        <div class="experience-item fade-in">
          <div class="experience-header">
            <h3>Church Initiative</h3>
            <span class="experience-meta">Non-profit &middot; Product Designer</span>
            <span class="experience-date">July 2023 &ndash; November 2024</span>
          </div>
          <ul class="experience-details">
            <li>Hired as the first and only product designer in the company, becoming the champion for user centered design internally</li>
            <li>Built internal design system with design token framework for use across product and marketing teams</li>
            <li>Introduced continuous discovery processes, conducting surveys and user interviews resulting in a new feature backlog</li>
            <li>Collaborated with product manager to gather requirements and prioritize tasks</li>
            <li>Produced proto-personas based on user journey mapping that resulted in discovering 4 unique user segments</li>
          </ul>
        </div>

        <div class="experience-item fade-in">
          <div class="experience-header">
            <h3>CrateBind</h3>
            <span class="experience-meta">Agency &middot; Product Designer</span>
            <span class="experience-date">October 2021 &ndash; June 2023</span>
          </div>
          <ul class="experience-details">
            <li>Led user centered design from initial requirements gathering and wireframes to high fidelity mockups for 6 client projects and 3 internal projects</li>
            <li>Designed experiences for responsive web and native mobile apps for B2B, B2C, and social media projects</li>
            <li>Built custom design systems catering to client and project needs</li>
            <li>Facilitated weekly feedback sessions with clients, leading to 3 project extensions</li>
            <li>Developed and launched 6 websites using Webflow in collaboration with delivery managers, clients, and design</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="featured-project section">
    <div class="container">
      <p class="featured-label fade-in">Want to see more? Check out my first case study for GriefShare's Find a Group 😸</p>
      <a href={`${base}/projects/griefshare`} class="featured-link fade-in">
        <img
          src={`${base}/images/projects/griefshare/thumbnail.png`}
          alt="GriefShare case study"
          class="featured-image"
          loading="lazy"
        />
      </a>
    </div>
  </section>

  <CTAFooter />
</BaseLayout>

<style>
  .about-hero {
    padding-top: var(--space-3xl);
  }

  .about-intro {
    margin-bottom: var(--space-3xl);
  }

  .intro-greeting {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .intro-headline {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    max-width: 700px;
    margin-bottom: 0;
  }

  .about-grid {
    display: grid;
    gap: var(--space-3xl);
    align-items: start;
  }

  .about-image-wrapper {
    max-width: 400px;
  }

  .profile-image {
    width: 100%;
    border-radius: 8px;
    background-color: var(--color-surface);
    aspect-ratio: 1;
    object-fit: cover;
  }

  .about-content p {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .about-content strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .resume-btn {
    display: inline-block;
    margin-top: var(--space-lg);
    padding: var(--space-sm) var(--space-xl);
    font-size: 1rem;
    font-weight: 500;
    color: white;
    background-color: var(--color-text);
    border-radius: 4px;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .resume-btn:hover {
    background-color: var(--color-accent-hover);
    color: white;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr 1.5fr;
    }
  }

  /* Experience Section */
  .section-title {
    margin-bottom: var(--space-2xl);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .experience-item {
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .experience-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .experience-header {
    margin-bottom: var(--space-md);
  }

  .experience-header h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-xs);
  }

  .experience-meta {
    display: block;
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    margin-bottom: var(--space-xs);
  }

  .experience-date {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .experience-details {
    list-style: disc;
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .experience-details li {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Featured Project */
  .featured-project {
    background-color: var(--color-surface);
  }

  .featured-label {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .featured-link {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .featured-link:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
  }

  .featured-image {
    width: 100%;
    height: auto;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.fade-in').forEach((el) => {
    gsap.from(el as Element, {
      scrollTrigger: {
        trigger: el as Element,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      opacity: 0,
      y: 30,
      duration: 0.6,
      ease: 'power3.out',
    });
  });
</script>
