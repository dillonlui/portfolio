---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portfolio | About">
  <section class="about-hero section">
    <div class="container">
      <div class="about-grid">
        <div class="about-image-wrapper fade-in">
          <img
            src="/images/placeholder.svg"
            alt="Profile photo"
            class="profile-image"
          />
        </div>
        <div class="about-content">
          <h1 class="about-title fade-in">About Me</h1>
          <div class="about-text fade-in">
            <p>
              I'm a designer and developer passionate about creating digital experiences
              that are both beautiful and functional. With a background in both design
              and engineering, I bring a unique perspective to every project.
            </p>
            <p>
              My work spans across product design, design systems, and front-end
              development. I believe in the power of thoughtful design to solve
              complex problems and create meaningful connections with users.
            </p>
            <p>
              When I'm not designing or coding, you can find me exploring new
              technologies, reading about design theory, or enjoying the outdoors.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="skills section">
    <div class="container">
      <h2 class="section-title fade-in">What I Do</h2>
      <div class="skills-grid">
        <div class="skill-card fade-in">
          <h3>Product Design</h3>
          <p>
            End-to-end product design from research and strategy through to
            high-fidelity prototypes and design systems.
          </p>
        </div>
        <div class="skill-card fade-in">
          <h3>Design Systems</h3>
          <p>
            Building scalable design systems that enable teams to ship consistent,
            high-quality products faster.
          </p>
        </div>
        <div class="skill-card fade-in">
          <h3>Front-End Development</h3>
          <p>
            Bringing designs to life with clean, performant code using modern
            frameworks and best practices.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="experience section">
    <div class="container content-width">
      <h2 class="section-title fade-in">Experience</h2>
      <div class="timeline">
        <div class="timeline-item fade-in">
          <span class="timeline-date">2022 - Present</span>
          <h3>Senior Product Designer</h3>
          <p class="timeline-company">Company Name</p>
          <p>Leading design for core product features and mentoring junior designers.</p>
        </div>
        <div class="timeline-item fade-in">
          <span class="timeline-date">2020 - 2022</span>
          <h3>Product Designer</h3>
          <p class="timeline-company">Another Company</p>
          <p>Designed and shipped features used by millions of users.</p>
        </div>
        <div class="timeline-item fade-in">
          <span class="timeline-date">2018 - 2020</span>
          <h3>UX Designer</h3>
          <p class="timeline-company">Startup Inc</p>
          <p>Built the design practice from the ground up at an early-stage startup.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding-top: var(--space-3xl);
  }

  .about-grid {
    display: grid;
    gap: var(--space-3xl);
    align-items: start;
  }

  .about-image-wrapper {
    max-width: 400px;
  }

  .profile-image {
    width: 100%;
    border-radius: 8px;
    background-color: var(--color-surface);
    aspect-ratio: 1;
    object-fit: cover;
  }

  .about-title {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .about-text p {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr 1.5fr;
    }
  }

  /* Skills Section */
  .section-title {
    margin-bottom: var(--space-2xl);
  }

  .skills-grid {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 768px) {
    .skills-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .skill-card {
    padding: var(--space-xl);
    background-color: var(--color-surface);
    border-radius: 8px;
  }

  .skill-card h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-sm);
  }

  .skill-card p {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    margin: 0;
  }

  /* Experience Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .timeline-item {
    padding-left: var(--space-xl);
    border-left: 2px solid var(--color-border);
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .timeline-date {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    display: block;
    margin-bottom: var(--space-xs);
  }

  .timeline-item h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-xs);
  }

  .timeline-company {
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .timeline-item > p:last-child {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    margin: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animate elements on scroll
  gsap.utils.toArray('.fade-in').forEach((el) => {
    gsap.from(el as Element, {
      scrollTrigger: {
        trigger: el as Element,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      opacity: 0,
      y: 30,
      duration: 0.6,
      ease: 'power3.out',
    });
  });
</script>
