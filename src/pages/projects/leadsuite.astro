---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import AtAGlance from '../../components/AtAGlance.astro';
import InsightCallout from '../../components/InsightCallout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import FullWidthImage from '../../components/FullWidthImage.astro';

import thumbnail from '../../assets/images/projects/leadsuite/thumbnail.png';
import personPageOld from '../../assets/images/projects/leadsuite/Person-page-old.png';
import personProfileNew from '../../assets/images/projects/leadsuite/person-profile-new.png';
import caseDetail from '../../assets/images/projects/leadsuite/case-detail.png';
import caseDetailTimelineMap from '../../assets/images/projects/leadsuite/case-detail-timeline-map.png';
import leadReviewPerson from '../../assets/images/projects/leadsuite/lead-review-person.png';
import dashboardPropertyPanel from '../../assets/images/projects/leadsuite/dashboard-property-panel.png';
---

<CaseStudyLayout
  title="LeadSuite"
  description="LeadSuite is the flagship investigative platform at LeadsOnline. I turned a vague ask to make a legacy interface easier to use into a scalable product foundation, redesigning the core person and case workflows that now support over half of platform traffic."
  tags={['B2B SaaS', 'Product Strategy', 'Information Architecture']}
  heroImage={thumbnail}
  slug="leadsuite"
  accentColor="#1c3557"
  previousProject={{ title: 'GriefShare', slug: 'griefshare' }}
  nextProject={{ title: 'Deposify', slug: 'deposify' }}
>
  <div class="case-study-body">

    <div class="container">
      <p class="disclaimer">*This work involves sensitive law-enforcement investigations, so I can't share full details publicly. These visuals are representative of the live product, and I'm glad to walk through the complete case study and design decisions in conversation.*</p>
    </div>

    <!-- At a Glance -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading title="At a Glance" />
        <AtAGlance
          role="Lead Product Designer"
          team="1 PM, 1 Product Analyst, 1 Tech Lead, 5 Engineers, 1 QA"
          timeline="Ongoing since Dec 2024"
          outcomes={[
            { label: '50%+ of platform traffic', text: 'The redesigned person profile now drives over half of all traffic in the app, making the new IA a core product surface rather than a cosmetic improvement.' },
            { label: 'Scalable product foundation', text: 'The tabbed architecture has already absorbed 2 new data source integrations without layout changes, supporting product velocity beyond the initial redesign.' },
            { label: 'Ambiguity turned into direction', text: 'Translated a directional PM ask ("make it easier to use") into a buildable information architecture and a clearer model for future investigative workflows.' },
          ]}
        />
      </div>
    </section>

    <!-- Challenge -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading
          title="The Product Challenge"
          subtitle="LeadSuite was the flagship platform, but its core workflows were still shaped by a low-adoption legacy product. The interface had been reskinned without rethinking how investigators actually move through people, cases, evidence, and leads. The risk was not just poor usability. The product needed a structure that could support daily use, new data sources, and the next generation of AI-driven workflows."
        />
        <p class="design-question"><strong>Product Question:</strong> How do you turn a dense legacy interface into a scalable foundation for the flagship investigative platform?</p>
      </div>
    </section>

    <!-- From Vague Ask to Product Foundation -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading
          title="From Vague Ask to Product Foundation"
          subtitle='The initial brief was simple: "make it easier to use." I used a UX audit and team facilitation to turn that directional ask into a product model the team could build from. The work became less about reorganizing screens and more about defining durable places for the product to grow.'
        />
        <div class="insights-grid">
          <InsightCallout
            title="Clarified the model"
            description="The person profile needed to become a structured hub for cases, associates, activity, and background data instead of a single page where every fact competed for attention."
          />
          <InsightCallout
            title="Created room for growth"
            description="The case detail needed distinct views for summary, spatial-temporal analysis, evidence, and leads so future capabilities could be added without collapsing back into a wall of data."
          />
          <InsightCallout
            title="Aligned the team"
            description="Audit findings gave product and engineering a concrete way to discuss tradeoffs, turning vague requirements into specific, buildable decisions."
          />
        </div>
      </div>
    </section>

    <!-- Pain Points -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading title="What We Were Up Against" />
        <div class="insights-grid">
          <InsightCallout
            title="Wall of noise"
            description="The person profile loaded every data point simultaneously with no visual hierarchy. Investigators had to scan the entire page to find what they needed, with no tabbed structure, no grouping, no clear entry point."
          />
          <InsightCallout
            title="Hard to follow, harder to discover"
            description="The original timeline and map design required cumbersome dual-axis scrolling to navigate. Enough functionality was buried or unclear that investigators, including me during the audit, were missing it entirely."
          />
          <InsightCallout
            title="Vague requirements"
            description="PM asks were directional, not defined. I used the audit findings as a foundation, then facilitated team discussions to translate broad concerns into specific decisions about navigation, hierarchy, and product structure."
          />
        </div>
      </div>
    </section>

    <!-- Person Profile -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading
          title="Person Profile"
          subtitle="The person profile became the clearest proof point for the new product structure. I introduced a tabbed model - Cases, Associates, Activity Log, and a new 'Deep Background' tab - that gives investigators a direct path to the information they need while giving the product team durable places to add new data sources."
        />
        <BeforeAfter
          beforeImage={personPageOld}
          afterImage={personProfileNew}
          beforeLabel="Before"
          afterLabel="After"
          beforeAlt="Original LeadSuite person page with flat layout"
          afterAlt="Redesigned person profile with tabbed navigation and organized sections"
        />
        <p class="pull-quote">The redesigned person profile now drives over 50% of all traffic in the app.</p>
      </div>
    </section>

    <!-- Case Detail Overview -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading
          title="Case Detail"
          subtitle="The case detail page is where investigators spend most of their time, so it needed to work as an operating surface, not a report. I restructured it around a vertical navigation with distinct views: an overview with the case summary and map, a timeline and map view for spatial-temporal analysis, and an evidence tab. Each view supports a different mode of investigative thinking without cluttering the others."
        />
        <FullWidthImage
          src={caseDetail}
          alt="Redesigned case detail overview showing case summary, leads cards, and map"
          caption="Case detail overview: summary narrative, leads cards, and geographic context in one view"
        />
      </div>
    </section>

    <!-- Timeline + Map -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading
          title="Timeline + Map"
          subtitle="I redesigned the timeline as a full-width horizontal view, synced to the map, so investigators get two representations of the same facts for two different ways of thinking through a case. Events scroll chronologically left to right, and selecting one highlights its location on the map below."
        />
        <FullWidthImage
          src={caseDetailTimelineMap}
          alt="Case detail timeline and map view with narrative events synced to geographic locations"
          caption="Timeline + Map: narrative events synced to geographic locations for spatial-temporal analysis"
        />
      </div>
    </section>

    <!-- Leads -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading
          title="Leads"
          subtitle="Leads is a net new feature, built in close collaboration with one of the developers. He brought the concept, and we workshopped it together until it became a focused workspace where investigators could track threads tied to a case, separate from the raw data views. It's designed to feel like a working surface, not a report."
        />
        <FullWidthImage
          src={leadReviewPerson}
          alt="Lead review modal showing a person of interest with investigative leads and intel connections"
          caption="Lead review: surfacing proximity, timing, and cross-case connections for a person of interest"
        />
      </div>
    </section>

    <!-- What's Next -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading
          title="What's Next"
          subtitle='The redesign launched first to beta users, then expanded to a controlled subset of existing LeadsOnline customers, with a full rollout weeks away. Because the core IA now has clearer places for data, activity, leads, and search, it is becoming the foundation for two larger product bets: a Dashboard surfacing personalized investigative activity and trend detection, and an AI-powered search. The vision for where these features lead is covered in <a href="/projects/unified-platform">Unifying an Investigative Platform</a>.'
        />
        <FullWidthImage
          src={dashboardPropertyPanel}
          alt="LeadSuite dashboard with analytics, trends, and property intelligence panel"
          caption="Dashboard with property intelligence panel: personalized activity, analytics, and trend detection"
        />
      </div>
    </section>

    <!-- Reflection -->
    <section class="case-section section">
      <div class="container">
        <SectionHeading title="Reflection" />
        <div class="reflections-grid">
          <div class="reflection-item">
            <h3>Real usage, real validation</h3>
            <p>The redesigned person profile now drives over 50% of all traffic in the app. That signal confirmed the new structure had become a core product surface, not just a cleaner way to arrange content.</p>
          </div>
          <div class="reflection-item">
            <h3>Scalable structure pays off</h3>
            <p>The tabbed model has already absorbed two new data source integrations without touching the core layout. Building for growth was not over-engineering, it was the right call for a flagship product with an expanding roadmap.</p>
          </div>
          <div class="reflection-item">
            <h3>Ambiguity is a design surface</h3>
            <p>The vaguest asks often point to the most important problems. "Make it easier to use" turned into a full information architecture rethink.</p>
          </div>
        </div>
      </div>
    </section>

  </div>
</CaseStudyLayout>

<script>
  import { initCaseStudyAnimations } from '../../scripts/scroll-animations';
  import { initScrollVelocityParallax } from '../../scripts/hover-effects';
  document.addEventListener('astro:page-load', () => {
    if (!window.location.pathname.startsWith('/projects/leadsuite')) return;
    initCaseStudyAnimations('.case-section');
    initScrollVelocityParallax();
  });
</script>
