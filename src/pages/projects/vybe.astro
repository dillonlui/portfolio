---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import FeatureShowcase from '../../components/FeatureShowcase.astro';
import SectionHeading from '../../components/SectionHeading.astro';

import heroImg from '../../assets/images/projects/vybe/hero.png';
import newsfeed from '../../assets/images/projects/vybe/newsfeed.png';
import eventDetails from '../../assets/images/projects/vybe/event-details.png';
import hangoutCreation from '../../assets/images/projects/vybe/hangout-creation.png';
import textInvites from '../../assets/images/projects/vybe/text-invites.png';
import feature5 from '../../assets/images/projects/vybe/feature5.png';
---

<CaseStudyLayout
  title="Vybe"
  description="Vybe is a social media app that curates a newsfeed of nearby real time events. Vybe is the best way for Gen Z to plan a night out and connect with people in their city."
  tags={['Social Media', 'iOS | Android']}
  heroImage={heroImg}
  previousProject={{ title: 'RMC', slug: 'rmc' }}
  nextProject={{ title: 'Deposify', slug: 'deposify' }}
>
  <section class="case-section section">
    <div class="container">
      <div class="features">
        <FeatureShowcase
          image={newsfeed}
          title="Hangout Newsfeed"
        />
        <FeatureShowcase
          image={eventDetails}
          title="Event Details and Guest List"
          reverse
        />
        <FeatureShowcase
          image={hangoutCreation}
          title="Intuitive Hangout Creation Flow"
        />
        <FeatureShowcase
          image={textInvites}
          title="Custom Text Invites"
          reverse
        />
        <FeatureShowcase
          image={feature5}
          title="Connect with People Nearby"
        />
      </div>
    </div>
  </section>
</CaseStudyLayout>

<style>
  .features {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }
</style>

<script>
  import { initCaseStudyAnimations } from '../../scripts/scroll-animations';
  document.addEventListener('astro:page-load', () => {
    if (!window.location.pathname.startsWith('/projects/vybe')) return;
    initCaseStudyAnimations('.feature-showcase');
  });
</script>
