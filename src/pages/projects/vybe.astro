---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import FeatureShowcase from '../../components/FeatureShowcase.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const base = import.meta.env.BASE_URL;
const img = `${base}/images/projects/vybe`;
---

<CaseStudyLayout
  title="Vybe"
  description="Vybe is a social media app that curates a newsfeed of nearby real time events. Vybe is the best way for Gen Z to plan a night out and connect with people in their city."
  tags={['Social Media', 'iOS | Android']}
  heroImage={`${img}/hero.png`}
  logoImage={`${img}/logo.png`}
  previousProject={{ title: 'RMC', slug: 'rmc' }}
  nextProject={{ title: 'Deposify', slug: 'deposify' }}
>
  <section class="case-section section">
    <div class="container">
      <div class="features">
        <FeatureShowcase
          image={`${img}/newsfeed.png`}
          title="Hangout Newsfeed"
        />
        <FeatureShowcase
          image={`${img}/event-details.png`}
          title="Event Details and Guest List"
          reverse
        />
        <FeatureShowcase
          image={`${img}/hangout-creation.png`}
          title="Intuitive Hangout Creation Flow"
        />
        <FeatureShowcase
          image={`${img}/text-invites.png`}
          title="Custom Text Invites"
          reverse
        />
        <FeatureShowcase
          image={`${img}/feature5.png`}
          title="Connect with People Nearby"
        />
      </div>
    </div>
  </section>
</CaseStudyLayout>

<style>
  .features {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.feature-showcase').forEach((el) => {
    gsap.from(el as Element, {
      scrollTrigger: {
        trigger: el as Element,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      opacity: 0,
      y: 40,
      duration: 0.6,
      ease: 'power3.out',
    });
  });
</script>
