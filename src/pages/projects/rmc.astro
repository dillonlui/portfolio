---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import FullWidthImage from '../../components/FullWidthImage.astro';
import FeatureShowcase from '../../components/FeatureShowcase.astro';
import SectionHeading from '../../components/SectionHeading.astro';

import headerImg from '../../assets/images/projects/rmc/header.png';
import wireframes1 from '../../assets/images/projects/rmc/wireframes1.png';
import wireframes2 from '../../assets/images/projects/rmc/wireframes2.png';
import categories from '../../assets/images/projects/rmc/categories.png';
import iaExploration from '../../assets/images/projects/rmc/ia-exploration.png';
import marketplace from '../../assets/images/projects/rmc/marketplace.png';
import solutions from '../../assets/images/projects/rmc/solutions.png';
import categoryPages from '../../assets/images/projects/rmc/category-pages.png';
import searchFilter from '../../assets/images/projects/rmc/search-filter.png';
---

<CaseStudyLayout
  noindex
  title="RecruitmentMarketing.com"
  description="RecruitmentMarketing.com (RMC) is a marketplace to help recruitment marketing professionals find the right tools and services."
  tags={['B2B Marketplace', 'Responsive Web']}
  heroImage={headerImg}
  previousProject={{ title: 'Deposify', slug: 'deposify' }}
  nextProject={{ title: 'Vybe', slug: 'vybe' }}
>
  <section class="case-section section">
    <div class="container">
      <SectionHeading title="Wireframes" />
      <div class="wireframes-grid">
        <FullWidthImage src={wireframes1} alt="RMC wireframes - page layouts" />
        <FullWidthImage src={wireframes2} alt="RMC wireframes - component exploration" />
      </div>
    </div>
  </section>

  <section class="case-section section">
    <div class="container">
      <SectionHeading title="Resolving the Information Architecture" />
      <div class="ia-images">
        <FullWidthImage src={categories} alt="Category structure exploration" />
        <FullWidthImage src={iaExploration} alt="Information architecture exploration" />
      </div>
    </div>
  </section>

  <section class="case-section section">
    <div class="container">
      <div class="features">
        <FeatureShowcase
          image={marketplace}
          title="An Intuitive Marketplace"
        />
        <FeatureShowcase
          image={solutions}
          title="Customizable Solution Pages"
          reverse
        />
        <FeatureShowcase
          image={categoryPages}
          title="Educating Users with Category Pages"
        />
        <FeatureShowcase
          image={searchFilter}
          title="Global Search and Filter"
          reverse
        />
      </div>
    </div>
  </section>
</CaseStudyLayout>

<style>
  .wireframes-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .ia-images {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .features {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }
</style>

<script>
  import { initCaseStudyAnimations } from '../../scripts/scroll-animations';
  document.addEventListener('astro:page-load', () => {
    if (!window.location.pathname.startsWith('/projects/rmc')) return;
    initCaseStudyAnimations('.feature-showcase, .full-width-image, .section-heading');
  });
</script>
