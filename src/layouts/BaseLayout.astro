---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = 'Portfolio of design and development work', image, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonicalUrl.href} />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/sansita-one-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-black-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dillon Lui - Product Designer" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  main {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-accent);
    color: white;
    border-radius: var(--radius-sm);
    z-index: var(--z-overlay);
    text-decoration: none;
    font-weight: 500;
  }

  .skip-link:focus {
    top: var(--space-md);
    color: white;
  }

  /* Custom cursor: accent green fill, white outline */
  #custom-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    margin-left: -10px;
    margin-top: -10px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid #fff;
    pointer-events: none;
    z-index: var(--z-cursor);
    opacity: 0;
    transition: opacity 200ms ease, width 200ms ease, height 200ms ease, margin 200ms ease, background 200ms ease;
    will-change: transform;
    mix-blend-mode: normal;
  }

  #custom-cursor.is-visible {
    opacity: 1;
  }

  #custom-cursor.is-hovering {
    width: 32px;
    height: 32px;
    margin-left: -16px;
    margin-top: -16px;
    background: rgba(32, 93, 23, 0.15);
    border-color: var(--color-accent);
  }

  /* Hide default cursor when custom cursor is active (desktop with fine pointer only) */
  @media (min-width: 768px) and (pointer: fine) {
    body.custom-cursor-active,
    body.custom-cursor-active * {
      cursor: none !important;
    }
  }

  /* Don't show custom cursor on mobile/touch */
  @media (max-width: 767px), (pointer: coarse) {
    #custom-cursor,
    #global-trail-canvas {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #custom-cursor,
    #global-trail-canvas {
      display: none !important;
    }
  }
</style>

<script>
  const layoutWindow = window as Window & {
    __portfolioBaseLayoutCleanup?: () => void;
    __portfolioCleanupGSAP?: () => void;
  };

  if (layoutWindow.__portfolioBaseLayoutCleanup) {
    layoutWindow.__portfolioBaseLayoutCleanup();
  }

  let cursorModule: typeof import('../scripts/light-trail') | null = null;
  let cursorGeneration = 0;

  async function setupCursor() {
    const generation = ++cursorGeneration;
    // Only load cursor trail on desktop with fine pointer
    const isDesktop = window.innerWidth >= 768;
    const isCoarse = window.matchMedia('(pointer: coarse)').matches;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!isDesktop || isCoarse || reducedMotion) {
      cursorModule?.destroyGlobalCursor();
      return;
    }
    cursorModule ??= await import('../scripts/light-trail');
    if (generation === cursorGeneration) cursorModule.initGlobalCursor();
  }

  async function setupInteractions() {
    if (window.innerWidth < 768 || window.matchMedia('(pointer: coarse), (prefers-reduced-motion: reduce)').matches) return;
    if (!document.querySelector('.btn, .cta-btn')) return;
    const { initButtonSheen } = await import('../scripts/button-sheen');
    initButtonSheen();
  }

  function handlePageLoad() {
    setupCursor();
    setupInteractions();
  }

  function handleBeforeSwap() {
    cursorGeneration++;
    cursorModule?.destroyGlobalCursor();
    layoutWindow.__portfolioCleanupGSAP?.();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', handlePageLoad, { once: true });
  } else {
    handlePageLoad();
  }

  // Reinit GSAP when crossing the mobile/desktop breakpoint
  let wasDesktop = window.innerWidth >= 768;
  let resizeTicking = false;
  function handleResize() {
    if (resizeTicking) return;
    resizeTicking = true;
    requestAnimationFrame(() => {
      resizeTicking = false;
      const isDesktop = window.innerWidth >= 768;
      if (isDesktop !== wasDesktop) {
        wasDesktop = isDesktop;
        layoutWindow.__portfolioCleanupGSAP?.();
        if (!isDesktop) cursorModule?.destroyGlobalCursor();
        document.dispatchEvent(new Event('astro:page-load'));
      }
    });
  }

  document.addEventListener('astro:before-swap', handleBeforeSwap);
  document.addEventListener('astro:page-load', handlePageLoad);
  window.addEventListener('resize', handleResize, { passive: true });

  layoutWindow.__portfolioBaseLayoutCleanup = () => {
    cursorGeneration++;
    cursorModule?.destroyGlobalCursor();
    document.removeEventListener('astro:before-swap', handleBeforeSwap);
    document.removeEventListener('astro:page-load', handlePageLoad);
    window.removeEventListener('resize', handleResize);
  };
</script>
