---
import BaseLayout from './BaseLayout.astro';
import CaseStudyHero from '../components/CaseStudyHero.astro';
import ProjectNav from '../components/ProjectNav.astro';
import CTAFooter from '../components/CTAFooter.astro';
import CaseStudyLightbox from '../components/CaseStudyLightbox.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import '../styles/case-study.css';

interface Props {
  title: string;
  description: string;
  tags: string[];
  heroImage: string;
  logoImage?: string;
  slug?: string;
  accentColor?: string;
  previousProject?: { title: string; slug: string };
  nextProject?: { title: string; slug: string };
}

const {
  title,
  description,
  tags,
  heroImage,
  logoImage,
  slug,
  accentColor = '#1a1a1a',
  previousProject,
  nextProject,
} = Astro.props;
---

<BaseLayout title={`${title} Case Study - Dillon Lui`} description={description} image={heroImage}>
  <ScrollProgress />
  <CaseStudyHero
    title={title}
    description={description}
    tags={tags}
    heroImage={heroImage}
    logoImage={logoImage}
    slug={slug}
    accentColor={accentColor}
  />
  <slot />
  <CaseStudyLightbox />
  <ProjectNav
    previousProject={previousProject}
    nextProject={nextProject}
  />
  <CTAFooter />
</BaseLayout>

<Fragment set:html={`<style>:root { --color-project-accent: ${accentColor}; }</style>`} />
